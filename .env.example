APP_NAME=SendIO
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
AUTH_GUARD=api

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=debug
LOG_DAILY_DAYS=30

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=sendio
DB_USERNAME=sendio_user
DB_PASSWORD=sendio_pass

MONGO_DB_HOST=mongodb
MONGO_DB_PORT=27017
MONGO_DB_DATABASE=sendio_logs
MONGO_DB_USERNAME=root
MONGO_DB_PASSWORD=rootpassword

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

QUEUE_CONNECTION=redis

# Mail sandbox (non-production)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=mailtrap_user
MAIL_PASSWORD=mailtrap_password
MAIL_FROM_ADDRESS=no-reply@sendio.local
MAIL_FROM_NAME="${APP_NAME}"
